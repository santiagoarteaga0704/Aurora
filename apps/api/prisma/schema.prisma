generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model almacen {
  id                                                      Int                     @id @default(autoincrement())
  sucursal_id                                             Int
  codigo                                                  String                  @unique @db.VarChar(20)
  nombre                                                  String                  @db.VarChar(120)
  tipo                                                    almacen_tipo            @default(venta)
  es_principal                                            Boolean                 @default(false)
  activo                                                  Boolean                 @default(true)
  sucursal                                                sucursal                @relation(fields: [sucursal_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_almacen_sucursal")
  compra                                                  compra[]
  inventario                                              inventario[]
  movimiento_inventario                                   movimiento_inventario[]
  pedido                                                  pedido[]
  transferencia_transferencia_almacen_destino_idToalmacen transferencia[]         @relation("transferencia_almacen_destino_idToalmacen")
  transferencia_transferencia_almacen_origen_idToalmacen  transferencia[]         @relation("transferencia_almacen_origen_idToalmacen")

  @@index([sucursal_id], map: "idx_almacen_sucursal")
}

model avatar {
  id             Int                 @id @default(autoincrement())
  cliente_id     Int                 @unique
  tipo_cuerpo    avatar_tipo_cuerpo?
  parametros     Json
  url_render     String?             @db.VarChar(255)
  actualizado_en DateTime            @default(now()) @db.Timestamptz(6)
  cliente        cliente             @relation(fields: [cliente_id], references: [usuario_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_avatar_cliente")
}

model bitacora {
  id            BigInt   @id @default(autoincrement())
  usuario_id    Int?
  accion        String   @db.VarChar(40)
  modulo        String   @db.VarChar(50)
  entidad       String?  @db.VarChar(60)
  entidad_id    String?  @db.VarChar(40)
  descripcion   String?  @db.VarChar(255)
  datos_previos Json?
  datos_nuevos  Json?
  ip            String?  @db.VarChar(45)
  user_agent    String?  @db.VarChar(255)
  creado_en     DateTime @default(now()) @db.Timestamptz(6)
  usuario       usuario? @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bitacora_usuario")

  @@index([creado_en], map: "idx_bitacora_fecha")
  @@index([modulo, entidad, entidad_id], map: "idx_bitacora_modulo")
  @@index([usuario_id], map: "idx_bitacora_usuario")
}

model caja {
  id              BigInt            @id @default(autoincrement())
  sucursal_id     Int
  usuario_id      Int
  monto_apertura  Decimal           @default(0) @db.Decimal(12, 2)
  monto_cierre    Decimal?          @db.Decimal(12, 2)
  monto_esperado  Decimal?          @db.Decimal(12, 2)
  diferencia      Decimal?          @db.Decimal(12, 2)
  estado          caja_estado       @default(abierta)
  abierta_en      DateTime          @default(now()) @db.Timestamptz(6)
  cerrada_en      DateTime?         @db.Timestamptz(6)
  sucursal        sucursal          @relation(fields: [sucursal_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_caja_sucursal")
  usuario         usuario           @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_caja_usuario")
  movimiento_caja movimiento_caja[]
}

model campania {
  id           Int           @id @default(autoincrement())
  nombre       String        @db.VarChar(120)
  descripcion  String?       @db.VarChar(255)
  tipo         campania_tipo
  banner_url   String?       @db.VarChar(255)
  fecha_inicio DateTime      @db.Timestamptz(6)
  fecha_fin    DateTime      @db.Timestamptz(6)
  activo       Boolean       @default(true)
  promocion    promocion[]
}

model carrito {
  id             BigInt         @id @default(autoincrement())
  cliente_id     Int?
  session_token  String         @unique @db.VarChar(64)
  creado_en      DateTime       @default(now()) @db.Timestamptz(6)
  actualizado_en DateTime       @default(now()) @db.Timestamptz(6)
  cliente        cliente?       @relation(fields: [cliente_id], references: [usuario_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_carrito_cliente")
  carrito_item   carrito_item[]
}

model carrito_item {
  id              BigInt   @id @default(autoincrement())
  carrito_id      BigInt
  variante_id     Int
  cantidad        Int      @default(1)
  precio_unitario Decimal  @db.Decimal(12, 2)
  agregado_en     DateTime @default(now()) @db.Timestamptz(6)
  carrito         carrito  @relation(fields: [carrito_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ci_carrito")
  variante        variante @relation(fields: [variante_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ci_variante")

  @@unique([carrito_id, variante_id], map: "uq_carrito_item")
}

model categoria {
  id              Int          @id @default(autoincrement())
  padre_id        Int?
  nombre          String       @db.VarChar(80)
  slug            String       @unique @db.VarChar(90)
  imagen          String?      @db.VarChar(255)
  orden           Int          @default(0)
  activo          Boolean      @default(true)
  categoria       categoria?   @relation("categoriaTocategoria", fields: [padre_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_categoria_padre")
  other_categoria categoria[]  @relation("categoriaTocategoria")
  guia_talla      guia_talla[]
  producto        producto[]

  @@index([padre_id], map: "idx_categoria_padre")
}

model ciudad {
  id                Int                 @id @default(autoincrement())
  departamento_id   Int
  nombre            String              @db.VarChar(80)
  activo            Boolean             @default(true)
  departamento      departamento        @relation(fields: [departamento_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ciudad_depto")
  direccion_cliente direccion_cliente[]
  sucursal          sucursal[]

  @@unique([departamento_id, nombre], map: "uq_ciudad")
}

model cliente {
  usuario_id         Int                 @id
  tipo               cliente_tipo        @default(minorista)
  nit                String?             @db.VarChar(20)
  razon_social       String?             @db.VarChar(150)
  mayorista_aprobado Boolean             @default(false)
  descuento_extra    Decimal             @default(0) @db.Decimal(5, 2)
  limite_credito     Decimal             @default(0) @db.Decimal(12, 2)
  fecha_nacimiento   DateTime?           @db.Date
  puntos             Int                 @default(0)
  avatar             avatar?
  carrito            carrito[]
  usuario            usuario             @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cliente_usuario")
  devolucion         devolucion[]
  direccion_cliente  direccion_cliente[]
  medida_cliente     medida_cliente?
  pedido             pedido[]
  prueba_virtual     prueba_virtual[]
  resena             resena[]
}

model color {
  id                 Int                  @id @default(autoincrement())
  nombre             String               @unique @db.VarChar(40)
  hex                String               @db.VarChar(7)
  producto_imagen    producto_imagen[]
  producto_prenda_3d producto_prenda_3d[]
  variante           variante[]
}

model compra {
  id             BigInt           @id @default(autoincrement())
  numero         String           @unique @db.VarChar(20)
  proveedor_id   Int
  almacen_id     Int
  usuario_id     Int
  fecha          DateTime         @db.Date
  subtotal       Decimal          @default(0) @db.Decimal(12, 2)
  descuento      Decimal          @default(0) @db.Decimal(12, 2)
  total          Decimal          @default(0) @db.Decimal(12, 2)
  estado         compra_estado    @default(borrador)
  creado_en      DateTime         @default(now()) @db.Timestamptz(6)
  almacen        almacen          @relation(fields: [almacen_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_compra_almacen")
  proveedor      proveedor        @relation(fields: [proveedor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_compra_proveedor")
  usuario        usuario          @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_compra_usuario")
  compra_detalle compra_detalle[]
}

model compra_detalle {
  id             BigInt   @id @default(autoincrement())
  compra_id      BigInt
  variante_id    Int
  cantidad       Int
  costo_unitario Decimal  @db.Decimal(12, 2)
  subtotal       Decimal  @db.Decimal(12, 2)
  compra         compra   @relation(fields: [compra_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cd_compra")
  variante       variante @relation(fields: [variante_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cd_variante")
}

model consulta_reporte {
  id                BigInt                   @id @default(autoincrement())
  conversacion_id   BigInt?
  usuario_id        Int
  plantilla_id      Int?
  pregunta          String
  entrada           consulta_reporte_entrada @default(texto)
  parametros        Json?
  sql_ejecutado     String?
  filas             Int?
  exito             Boolean                  @default(true)
  error             String?                  @db.VarChar(255)
  duracion_ms       Int?
  creado_en         DateTime                 @default(now()) @db.Timestamptz(6)
  conversacion      conversacion?            @relation(fields: [conversacion_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cr_conversacion")
  plantilla_reporte plantilla_reporte?       @relation(fields: [plantilla_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cr_plantilla")
  usuario           usuario                  @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cr_usuario")

  @@index([usuario_id, creado_en], map: "idx_cr_usuario")
}

model conversacion {
  id               BigInt             @id @default(autoincrement())
  usuario_id       Int?
  session_token    String             @db.VarChar(64)
  canal            conversacion_canal @default(web)
  tipo             conversacion_tipo  @default(asistente_compra)
  titulo           String?            @db.VarChar(150)
  creado_en        DateTime           @default(now()) @db.Timestamptz(6)
  actualizado_en   DateTime           @default(now()) @db.Timestamptz(6)
  consulta_reporte consulta_reporte[]
  usuario          usuario?           @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_conv_usuario")
  mensaje          mensaje[]

  @@index([session_token], map: "idx_conv_session")
}

model departamento {
  id     Int      @id @default(autoincrement())
  nombre String   @unique @db.VarChar(60)
  pais   String   @default("Bolivia") @db.VarChar(60)
  activo Boolean  @default(true)
  ciudad ciudad[]
}

model devolucion {
  id                  BigInt               @id @default(autoincrement())
  numero              String               @unique @db.VarChar(20)
  pedido_id           BigInt
  cliente_id          Int?
  motivo              devolucion_motivo
  detalle             String?              @db.VarChar(255)
  estado              devolucion_estado    @default(solicitada)
  monto_reembolso     Decimal              @default(0) @db.Decimal(12, 2)
  usuario_gestiona_id Int?
  creado_en           DateTime             @default(now()) @db.Timestamptz(6)
  cerrado_en          DateTime?            @db.Timestamptz(6)
  cliente             cliente?             @relation(fields: [cliente_id], references: [usuario_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_dev_cliente")
  pedido              pedido               @relation(fields: [pedido_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_dev_pedido")
  usuario             usuario?             @relation(fields: [usuario_gestiona_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_dev_usuario")
  devolucion_detalle  devolucion_detalle[]
}

model devolucion_detalle {
  id                BigInt                           @id @default(autoincrement())
  devolucion_id     BigInt
  pedido_detalle_id BigInt
  variante_id       Int
  cantidad          Int
  estado_prenda     devolucion_detalle_estado_prenda @default(nueva)
  reingresa_stock   Boolean                          @default(true)
  pedido_detalle    pedido_detalle                   @relation(fields: [pedido_detalle_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_dd_detalle")
  devolucion        devolucion                       @relation(fields: [devolucion_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_dd_devolucion")
  variante          variante                         @relation(fields: [variante_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_dd_variante")
}

model direccion_cliente {
  id           Int      @id @default(autoincrement())
  cliente_id   Int
  alias        String   @db.VarChar(50)
  ciudad_id    Int
  direccion    String   @db.VarChar(200)
  referencia   String?  @db.VarChar(200)
  latitud      Decimal? @db.Decimal(10, 7)
  longitud     Decimal? @db.Decimal(10, 7)
  destinatario String?  @db.VarChar(120)
  telefono     String?  @db.VarChar(30)
  es_principal Boolean  @default(false)
  activo       Boolean  @default(true)
  ciudad       ciudad   @relation(fields: [ciudad_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_dir_ciudad")
  cliente      cliente  @relation(fields: [cliente_id], references: [usuario_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_dir_cliente")
  envio        envio[]
  pedido       pedido[]

  @@index([cliente_id], map: "idx_dir_cliente")
}

model dispositivo {
  id             Int                    @id @default(autoincrement())
  usuario_id     Int?
  uuid           String                 @unique @db.VarChar(64)
  plataforma     dispositivo_plataforma
  modelo         String?                @db.VarChar(80)
  push_token     String?                @db.VarChar(255)
  ultima_sync    DateTime?              @db.Timestamptz(6)
  creado_en      DateTime               @default(now()) @db.Timestamptz(6)
  usuario        usuario?               @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_dispositivo_usuario")
  sesion         sesion[]
  sync_operacion sync_operacion[]
}

model envio {
  id                BigInt             @id @default(autoincrement())
  pedido_id         BigInt             @unique
  direccion_id      Int?
  repartidor_id     Int?
  empresa           String?            @db.VarChar(80)
  tracking          String?            @db.VarChar(80)
  estado            envio_estado       @default(preparando)
  costo             Decimal            @default(0) @db.Decimal(12, 2)
  fecha_estimada    DateTime?          @db.Date
  entregado_en      DateTime?          @db.Timestamptz(6)
  evidencia_url     String?            @db.VarChar(255)
  direccion_cliente direccion_cliente? @relation(fields: [direccion_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_envio_direccion")
  pedido            pedido             @relation(fields: [pedido_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_envio_pedido")
  usuario           usuario?           @relation(fields: [repartidor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_envio_repartidor")
}

model escala_precio {
  id              Int      @id @default(autoincrement())
  variante_id     Int
  cantidad_min    Int
  precio_unitario Decimal  @db.Decimal(12, 2)
  variante        variante @relation(fields: [variante_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_escala_variante")

  @@unique([variante_id, cantidad_min], map: "uq_escala")
}

model guia_talla {
  id           Int       @id @default(autoincrement())
  categoria_id Int
  talla_id     Int
  busto_min    Decimal?  @db.Decimal(5, 1)
  busto_max    Decimal?  @db.Decimal(5, 1)
  cintura_min  Decimal?  @db.Decimal(5, 1)
  cintura_max  Decimal?  @db.Decimal(5, 1)
  cadera_min   Decimal?  @db.Decimal(5, 1)
  cadera_max   Decimal?  @db.Decimal(5, 1)
  altura_min   Decimal?  @db.Decimal(5, 1)
  altura_max   Decimal?  @db.Decimal(5, 1)
  categoria    categoria @relation(fields: [categoria_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_guia_categoria")
  talla        talla     @relation(fields: [talla_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_guia_talla")

  @@unique([categoria_id, talla_id], map: "uq_guia")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inventario {
  id              BigInt   @id @default(autoincrement())
  variante_id     Int
  almacen_id      Int
  stock           Int      @default(0)
  stock_reservado Int      @default(0)
  stock_minimo    Int      @default(0)
  ubicacion       String?  @db.VarChar(40)
  actualizado_en  DateTime @default(now()) @db.Timestamptz(6)
  almacen         almacen  @relation(fields: [almacen_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_inv_almacen")
  variante        variante @relation(fields: [variante_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_inv_variante")

  @@unique([variante_id, almacen_id], map: "uq_inventario")
  @@index([almacen_id], map: "idx_inv_almacen")
}

model marca {
  id       Int        @id @default(autoincrement())
  nombre   String     @unique @db.VarChar(80)
  slug     String     @unique @db.VarChar(90)
  logo     String?    @db.VarChar(255)
  activo   Boolean    @default(true)
  producto producto[]
}

model medida_cliente {
  id             Int                   @id @default(autoincrement())
  cliente_id     Int                   @unique(map: "uq_medida_cliente")
  altura_cm      Decimal               @db.Decimal(5, 1)
  peso_kg        Decimal               @db.Decimal(5, 1)
  busto_cm       Decimal?              @db.Decimal(5, 1)
  cintura_cm     Decimal?              @db.Decimal(5, 1)
  cadera_cm      Decimal?              @db.Decimal(5, 1)
  entrepierna_cm Decimal?              @db.Decimal(5, 1)
  hombro_cm      Decimal?              @db.Decimal(5, 1)
  origen         medida_cliente_origen @default(manual)
  actualizado_en DateTime              @default(now()) @db.Timestamptz(6)
  cliente        cliente               @relation(fields: [cliente_id], references: [usuario_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_medida_cliente")
}

model mensaje {
  id              BigInt       @id @default(autoincrement())
  conversacion_id BigInt
  rol             mensaje_rol
  contenido       String?
  herramienta     String?      @db.VarChar(60)
  payload         Json?
  audio_url       String?      @db.VarChar(255)
  tokens_entrada  Int?
  tokens_salida   Int?
  latencia_ms     Int?
  creado_en       DateTime     @default(now()) @db.Timestamptz(6)
  conversacion    conversacion @relation(fields: [conversacion_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_msg_conversacion")

  @@index([conversacion_id, creado_en], map: "idx_msg_conv")
}

model metodo_pago {
  id                   Int               @id @default(autoincrement())
  codigo               String            @unique @db.VarChar(30)
  nombre               String            @db.VarChar(60)
  tipo                 metodo_pago_tipo
  requiere_comprobante Boolean           @default(false)
  disponible_offline   Boolean           @default(false)
  canal                metodo_pago_canal @default(todos)
  activo               Boolean           @default(true)
  pago                 pago[]
}

model movimiento_caja {
  id        BigInt               @id @default(autoincrement())
  caja_id   BigInt
  tipo      movimiento_caja_tipo
  monto     Decimal              @db.Decimal(12, 2)
  concepto  String               @db.VarChar(150)
  pago_id   BigInt?
  creado_en DateTime             @default(now()) @db.Timestamptz(6)
  caja      caja                 @relation(fields: [caja_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_mc_caja")
  pago      pago?                @relation(fields: [pago_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_mc_pago")
}

model movimiento_inventario {
  id               BigInt                     @id @default(autoincrement())
  variante_id      Int
  almacen_id       Int
  tipo             movimiento_inventario_tipo
  cantidad         Int
  stock_resultante Int
  referencia_tipo  String?                    @db.VarChar(30)
  referencia_id    BigInt?
  usuario_id       Int?
  motivo           String?                    @db.VarChar(200)
  creado_en        DateTime                   @default(now()) @db.Timestamptz(6)
  almacen          almacen                    @relation(fields: [almacen_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_mov_almacen")
  usuario          usuario?                   @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_mov_usuario")
  variante         variante                   @relation(fields: [variante_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_mov_variante")

  @@index([referencia_tipo, referencia_id], map: "idx_mov_ref")
  @@index([variante_id, creado_en], map: "idx_mov_variante")
}

model notificacion {
  id         BigInt            @id @default(autoincrement())
  usuario_id Int
  titulo     String            @db.VarChar(120)
  mensaje    String            @db.VarChar(255)
  tipo       notificacion_tipo
  url        String?           @db.VarChar(255)
  leida      Boolean           @default(false)
  creado_en  DateTime          @default(now()) @db.Timestamptz(6)
  usuario    usuario           @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_notif_usuario")

  @@index([usuario_id, leida], map: "idx_notif_usuario")
}

model pago {
  id                  BigInt            @id @default(autoincrement())
  pedido_id           BigInt
  metodo_pago_id      Int
  monto               Decimal           @db.Decimal(12, 2)
  moneda              String            @default("BOB") @db.VarChar(3)
  estado              pago_estado       @default(pendiente)
  referencia_externa  String?           @db.VarChar(120)
  qr_payload          String?
  comprobante_url     String?           @db.VarChar(255)
  usuario_confirma_id Int?
  idempotency_key     String?           @unique @db.VarChar(36)
  creado_en           DateTime          @default(now()) @db.Timestamptz(6)
  confirmado_en       DateTime?         @db.Timestamptz(6)
  movimiento_caja     movimiento_caja[]
  metodo_pago         metodo_pago       @relation(fields: [metodo_pago_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pago_metodo")
