# ---------------------------------------------------------------------------
# AURORA - API. Copiar a .env y completar. El .env real no se versiona.
# ---------------------------------------------------------------------------

# Base de datos. En local es el contenedor Docker del puerto 5434 (los 5432 y
# 5433 ya estan ocupados por otros proyectos de la maquina).
DATABASE_URL="postgresql://aurora:aurora@localhost:5434/aurora?schema=public"

# Secreto de firma de los JWT. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Vida del token de acceso en segundos y del refresh en dias.
JWT_ACCESO_SEGUNDOS=3600
JWT_REFRESH_DIAS=30

PORT=8000
NODE_ENV=development

# Origenes permitidos por CORS, separados por coma (el PWA y Expo en local).
CORS_ORIGENES="http://localhost:5180,http://localhost:8081"

# Asistente de IA y reportes bajo demanda. Pendiente: ver ESTADO.md.
ANTHROPIC_API_KEY=""
